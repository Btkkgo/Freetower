asset_tags = PackedStringArray("bamboo", "vegetation")
allowed_biomes = PackedStringArray("bamboo")
scale_min = 0.8
scale_max = 1.25
rotation_mode = "YAW"
is_debug_proxy = true
production_approved = false
asset_revision = "foundation-v1"
