[sub_resource type="Resource" id="Resource_rock"]
script = ExtResource("2_asset")
asset_id = "debug_rock_proxy"
display_name = "DEBUG_PROXY Rock"
packed_scene = ExtResource("5_rock")
asset_tags = PackedStringArray("rock")
allowed_biomes = PackedStringArray("rock_hill", "coast", "ruins")
scale_min = 0.65
scale_max = 1.45
rotation_mode = "YAW"
slope_max = 90.0
is_debug_proxy = true
production_approved = false
