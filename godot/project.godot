; Engine configuration file.
; FT-GD-001 — Freetower Godot Foundation + Vertical Slice Whitebox

config_version=5

[application]

config/name="Freetower"
config/description="FT-GD-001 foundation and vertical slice whitebox"
run/main_scene="res://scenes/game/Game.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

[input]

move_forward={
"deadzone": 0.5,
"events": []
}
